# PostgreSQL connection string used by Drizzle ORM.
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_website"

# Public site URL (used for absolute links / metadata). Optional in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign admin session cookies. REQUIRED in production.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# Persistent uploads directory. In production, mount this path as a persistent
# volume so branding assets survive container restarts and redeploys.
UPLOAD_DIR="./uploads"

# Public base URL used to serve files from UPLOAD_DIR.
# Relative default:
NEXT_PUBLIC_UPLOAD_BASE_URL="/uploads"
# Absolute example behind a reverse proxy / CDN:
# NEXT_PUBLIC_UPLOAD_BASE_URL="https://example.com/uploads"
