# PostgreSQL connection string used by Drizzle ORM.
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_website"

# Public site URL (used for absolute links / metadata). Optional in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign admin session cookies. REQUIRED in production.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# ArvanCloud Object Storage (S3-compatible) — used by the admin file uploader.
# Credentials are server-only and must never be exposed to the browser.
S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
S3_REGION="ir-thr-at1"
S3_BUCKET="varmanli-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for reading uploaded objects: `${S3_PUBLIC_BASE_URL}/${key}`.
S3_PUBLIC_BASE_URL="https://varmanli-uploads.s3.ir-thr-at1.arvanstorage.ir"
